# Copy to deploy/.env; never overwrite root .env or backend/.env.
# Local checks use this tag. EC2 must use sdw0501/musicpets:sha-<full-commit-sha>.
BACKEND_IMAGE=musicpets-backend:local

# Final Vercel production origin, no trailing slash.
# Spotify must allow APP_ORIGIN/login/oauth2/code/spotify.
APP_ORIGIN=https://music-pets-lilac.vercel.app
HTTP_PORT=8088

# EC2's HTTPS backend origin; this is NOT the browser OAuth callback origin.
DOMAIN=musicpets.duckdns.org
TLS_CERT_DIR=/etc/letsencrypt
ACME_WEBROOT=/var/www/letsencrypt

# Generate two different random passwords (32 random bytes as hex).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Generate at least 64 random bytes as base64.
JWT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
GOOGLE_API_KEY=
