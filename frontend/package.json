    "axios": "^1.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.2.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
