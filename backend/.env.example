# Copy to .env and set your own local values. Never commit .env.
DB_URL=jdbc:mysql://127.0.0.1:3307/musicpets
DB_USERNAME=musicpets
# Set this to MYSQL_PASSWORD from the root .env (Compose does not load backend/.env).
DB_PASSWORD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
GOOGLE_API_KEY=

# Required: generate a unique secret from at least 64 random bytes.
# Example generation command (Node.js):
# node -e "console.log(require('node:crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# Local HTTP only. Production HTTPS uses true (the application default).
AUTH_COOKIE_SECURE=false

# Start the local cache from the repository root: docker compose up -d redis
MUSIC_CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
